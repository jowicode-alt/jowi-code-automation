# Copy to .env for local development. Never commit real values.
# Set API_ACCESS_TOKEN to a long random secret in the hosting environment.
# VIDEO_PROVIDER_API_KEY=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=
# API_ACCESS_TOKEN=
# DATABASE_URL=postgresql://user:password@host:5432/database
# JOB_DB_PATH=./data/jobs.sqlite3
# SCENE_ASSETS_DIR=./scene-assets  # optional; must contain scene-1.png ... scene-4.png
# AI_HORDE_API_KEY=0000000000  # anonymous key works, but has lowest priority
# AI_HORDE_MODEL=AlbedoBase XL (SDXL)
# AI_HORDE_BASE_URL=https://aihorde.net/api
# OUTPUT_DIR=./renders
TTS_VOICE=en-US-GuyNeural
TTS_RATE=-5%
TTS_PITCH=-8Hz
